# notepad++.exe — mirrors PowerEditor/gcc/makefile (the MSVC variant).
# All of PowerEditor/src/**/*.cpp (minus tools/), C++20, Win32 GUI subsystem,
# linked against Scintilla + Lexilla + Boost.Regex glue and the Win32 import libs.

# NppLibsVersion.h is generated by src/NppLibsVersionH-generator.bat (the VS
# pre-build event). For a fully self-contained blade build this would be a
# gen_rule; here it was generated once (it's gitignored).

windows_resources(
    name = 'npp_res',
    rc_files = glob(['**/*.rc'], exclude = ['tools/**']),
    visibility = ['PUBLIC'],
)

cc_binary(
    name = 'notepad++',
    srcs = glob(['**/*.cpp'], exclude = ['tools/**']),
    incs = [
        '.', 'DarkMode',
        'MISC', 'MISC/Common', 'MISC/Exception', 'MISC/PluginsManager',
        'MISC/Process', 'MISC/RegExt', 'MISC/crc16', 'MISC/hmac', 'MISC/md5',
        'MISC/sha1', 'MISC/sha2', 'MISC/sha512',
        'ScintillaComponent', 'uchardet', 'json', 'pugixml',
        'WinControls', 'WinControls/AboutDlg', 'WinControls/AnsiCharPanel',
        'WinControls/ClipboardHistory', 'WinControls/ColourPicker',
        'WinControls/ContextMenu', 'WinControls/DockingWnd',
        'WinControls/DocumentMap', 'WinControls/DoubleBuffer',
        'WinControls/FileBrowser', 'WinControls/FindCharsInRange',
        'WinControls/FunctionList', 'WinControls/Grid', 'WinControls/ImageListSet',
        'WinControls/OpenSaveFileDialog', 'WinControls/PluginsAdmin',
        'WinControls/Preference', 'WinControls/ProjectPanel',
        'WinControls/ReadDirectoryChanges', 'WinControls/SplitterContainer',
        'WinControls/StaticDialog', 'WinControls/StaticDialog/RunDlg',
        'WinControls/StatusBar', 'WinControls/TabBar', 'WinControls/TaskList',
        'WinControls/ToolBar', 'WinControls/ToolTip', 'WinControls/TrayIcon',
        'WinControls/TreeView', 'WinControls/VerticalFileSwitcher',
        'WinControls/WindowsDlg', 'WinControls/shortcut',
        '../../scintilla/include', '../../lexilla/include',
    ],
    defs = [
        'UNICODE', '_UNICODE', 'OEMRESOURCE', 'NOMINMAX',
        '_WIN32_WINNT=_WIN32_WINNT_WIN7', 'NTDDI_VERSION=NTDDI_WIN7',
    ],
    extra_cxxflags = ['/std:c++20', '/bigobj'],
    extra_linkflags = [
        '/SUBSYSTEM:WINDOWS',
        # Embed Notepad++'s manifest (Common-Controls 6.0 + DPI awareness) the
        # same way the VS project does -- as a linker manifest input. Without it
        # the legacy v5 comctl32 loads and the v6-only ordinal imports (e.g.
        # comctl32 #381) fail at startup ("Ordinal Not Found"). /MANIFEST:EMBED
        # makes link.exe run mt.exe, which blade's link wrapper now finds by
        # prepending the SDK bin to PATH.
        '/MANIFEST:EMBED',
        '/MANIFESTINPUT:PowerEditor/src/notepad++.exe.manifest',
        'comctl32.lib', 'crypt32.lib', 'dbghelp.lib', 'ole32.lib', 'sensapi.lib',
        'shlwapi.lib', 'uuid.lib', 'uxtheme.lib', 'version.lib', 'wininet.lib',
        'wintrust.lib', 'dwmapi.lib', 'bcrypt.lib', 'imm32.lib', 'msimg32.lib',
        'oleaut32.lib',
        # Standard Win32 GUI import libs that MinGW links implicitly but MSVC
        # requires explicitly (GDI, USER, shell, common dialogs, etc.).
        'gdi32.lib', 'user32.lib', 'shell32.lib', 'comdlg32.lib', 'advapi32.lib',
        'winspool.lib', 'winmm.lib', 'gdiplus.lib', 'ws2_32.lib', 'oleacc.lib',
    ],
    deps = [
        '//scintilla:scintilla',
        '//lexilla:lexilla',
        '//boostregex:boost_regex',
        ':npp_res',
    ],
)
