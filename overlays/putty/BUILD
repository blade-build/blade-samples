# Exercises blade's gen_rule on Windows (#1204/#1279): run PuTTY's licence.pl
# generator (a real perl command -- perl must be on PATH) and capture licence.h
# into the build dir.
gen_rule(
    name = 'gen_licence',
    outs = ['licence.h'],
    # Run licence.pl (writes ./licence.h), copy it into the build dir as our
    # declared output, then delete the source-tree copy so the compile can ONLY
    # find the generated one (proving the chain). generated_hdrs marks it so
    # dependents build it first and find it on the include path.
    cmd_bat = r'perl licence.pl && copy /y licence.h $OUTS >nul && del licence.h',
    generated_hdrs = ['licence.h'],
    cmd_name = 'GEN licence.h',
)
